# ========================================================
# RMI AIS Tracker Configuration
# ========================================================

# Data Source Mode: "simulator", "aisstream", or "vesselfinder"
#
# RECOMMENDED: "aisstream" for precise positions, with background VesselFinder
# enrichment supplying GT/DWT/LOA/beam/year/flag (configured under
# `enrichment:` in config.yaml, enabled by default). VesselFinder cannot
# provide precise positions; aisstream cannot provide tonnage or year built.
AIS_DATA_SOURCE=aisstream

# aisstream.io API Key (Free registration at https://aisstream.io)
AISSTREAM_API_KEY=

# VesselFinder scraper (no key required - reads public vessel pages).
# Watchlist of MMSIs to poll; falls back to config.yaml vesselfinder.target_mmsis.
# NOTE: VesselFinder's public pages round coordinates to whole degrees (~55 km).
#       Use aisstream for precise positions; use vesselfinder for particulars.
VESSELFINDER_TARGET_MMSIS=
VESSELFINDER_POLL_INTERVAL_SEC=120

# Default Observer Station Identifier
DEFAULT_STATION_ID=Station-Desktop-01

# Web Dashboard Port & Host
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8000
