# ========================================================
# RMI AIS Tracker Configuration
# ========================================================

# Data Source Mode: "simulator", "aisstream", or "marinetraffic"
AIS_DATA_SOURCE=simulator

# aisstream.io API Key (Free registration at https://aisstream.io)
AISSTREAM_API_KEY=

# MarineTraffic API Key (Phase 3: 40-character hexadecimal key)
MARINETRAFFIC_API_KEY=

# Default Observer Station Identifier
DEFAULT_STATION_ID=Station-Desktop-01

# Web Dashboard Port & Host
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8000
